# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=America/Mexico_City

# Supabase (Project Settings → API). Llave pública: sirve NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (sb_publishable_…) o la legacy NEXT_PUBLIC_SUPABASE_ANON_KEY (eyJ…).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # secret key (sb_secret_…) o service_role legacy; solo la usan acciones de admin, webhooks y cron

# Integraciones (fases 2 a 4)
ANTHROPIC_API_KEY=
WHAAPY_API_KEY=
WHAAPY_WEBHOOK_SECRET=
WHAAPY_PHONE_E164=
FIREFLIES_API_KEY=
FIREFLIES_WEBHOOK_SECRET=
MICROSOFT_TENANT_ID=                  # Microsoft Entra ID: entrevistas en Outlook con reunión de Teams (plan §4.4)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=              # vence: anotar la fecha para renovarlo
RESEND_API_KEY=
RESEND_FROM=
CRON_SECRET=
ENCRYPTION_KEY=

# Datos de demostración en las vistas (1 = mocks, vacío = base de datos)
MOCK_DATA=            # 1 = todo demo · pipeline = solo candidatos/reportes/portal · core = solo clientes/vacantes · vacío = real
